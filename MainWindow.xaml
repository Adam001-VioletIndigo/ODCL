<Window
    x:Class="ODCL.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ODCL">

    <Grid x:Name="LayoutRoot" Padding="16" RowSpacing="8" SizeChanged="LayoutRoot_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 统计卡片区：卡片根据自身宽高自动切换横/纵向布局 -->
        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.35*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource StatCard}">
                <models:StatCard x:Name="CardTotal" />
            </Border>
            <Border Grid.Column="1" Style="{StaticResource StatCard}">
                <models:StatCard x:Name="CardEvent" Caption="event 事件数据（含索引）" />
            </Border>
            <Border Grid.Column="2" Style="{StaticResource StatCard}">
                <models:StatCard x:Name="CardRel" Caption="关联数据（消息/部件）" />
            </Border>
            <Border Grid.Column="3" Style="{StaticResource StatCard}">
                <models:StatCard x:Name="CardFree" Caption="freelist 空闲页" />
            </Border>
            <Border Grid.Column="4" Style="{StaticResource StatCard}">
                <models:StatCard x:Name="CardDisk" Caption="磁盘剩余（环为剩余占比）" />
            </Border>
        </Grid>

        <!-- 功能区：左=会话管理，中=弹性空隙，右=维护+迁移 单行排布 -->
        <Grid Grid.Row="1" Margin="0,2,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel>
                <TextBlock Text="会话管理" Style="{StaticResource ZoneLabel}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RefreshBtn" Content="刷新" Click="RefreshBtn_Click" />
                    <Button x:Name="DeleteBtn" Content="删除所选" Click="DeleteBtn_Click" />
                    <Button x:Name="SelectAllBtn" Content="全选" Click="SelectAllBtn_Click" />
                    <Button x:Name="ChangeDbBtn" Content="打开数据库" Click="ChangeDbBtn_Click" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,6,0,0" VerticalAlignment="Center">
                    <Button x:Name="TopNBtn" Padding="8,3" VerticalContentAlignment="Center" Click="TopNBtn_Click">
                        <StackPanel Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                            <TextBlock Text="选中前" FontSize="13" VerticalAlignment="Center" />
                            <TextBox x:Name="SelN" Width="34" Height="20" FontSize="13" Text="5" TextAlignment="Center"
                                     VerticalAlignment="Center" MinHeight="0" MinWidth="0" Padding="4,0"
                                     Background="{ThemeResource TextControlBackground}"
                                     BorderThickness="1" CornerRadius="5"
                                     BeforeTextChanging="SelN_BeforeTextChanging" />
                            <TextBlock Text="大" FontSize="13" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="SortBtn" Content="按占用降序" Click="SortBtn_Click" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="14" VerticalAlignment="Bottom">
                <StackPanel>
                    <TextBlock Text="数据库维护" Style="{StaticResource ZoneLabel}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="VacuumBtn" Content="重建" FontWeight="SemiBold" Click="VacuumBtn_Click" />
                        <TextBlock x:Name="DiskHint" VerticalAlignment="Center" FontSize="12" MaxWidth="150"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                   TextWrapping="Wrap"
                                   ToolTipService.ToolTip="磁盘剩余不足时，删除将自动分批执行，重建暂不可用" />
                    </StackPanel>
                </StackPanel>

                <StackPanel>
                    <TextBlock Text="存储迁移" Style="{StaticResource ZoneLabel}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button x:Name="MoveBtn" Content="转移数据库" Click="MoveBtn_Click" />
                        <FontIcon Glyph="&#xE946;" FontSize="14" VerticalAlignment="Center" Opacity="0.75"
                                  ToolTipService.ToolTip="通过符号链接将数据库转移到其他位置" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>
        </Grid>

        <!-- 主区域：两列均随窗口伸缩 -->
        <Grid Grid.Row="2" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" MinWidth="280" />
                <ColumnDefinition Width="1.15*" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="SessionList" SelectionMode="Multiple" SelectionChanged="SessionList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SessionItem">
                        <Border Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                                BorderThickness="1" CornerRadius="8" Margin="0,3" Padding="10,8">
                            <StackPanel>
                                <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                <TextBlock Text="{x:Bind Sub}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                                <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,5,0,0">
                                    <TextBlock Text="{x:Bind Id}" FontSize="11" FontFamily="Consolas"
                                               Opacity="0.75" VerticalAlignment="Center"
                                               TextTrimming="CharacterEllipsis" MaxWidth="270" />
                                    <Button Content="复制命令" Tag="{x:Bind Id}" Click="CopyCmd_Click"
                                            Padding="8,3" FontSize="11" VerticalAlignment="Center" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <!-- 会话内容区：卡片包裹，标题标注区域 -->
            <Grid Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="会话内容" Style="{StaticResource ZoneLabel}" Margin="2,0,0,0" />
                <Grid Grid.Row="1" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" MinHeight="160" />
                        <RowDefinition Height="0.55*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource StatCard}">
                        <TreeView x:Name="MsgTree" ItemInvoked="MsgTree_ItemInvoked" />
                    </Border>

                    <Border Grid.Row="1" Style="{StaticResource StatCard}">
                        <ScrollViewer>
                            <TextBlock x:Name="DetailText" IsTextSelectionEnabled="True" FontFamily="Consolas"
                                       FontSize="12" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!-- 状态行：版本号 + 进度条 -->
        <Grid Grid.Row="3" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Text="v1.0" FontSize="11" Opacity="0.45" VerticalAlignment="Center" />
            <ProgressBar x:Name="Progress" Grid.Column="1" Height="4" Visibility="Collapsed" />
        </Grid>
    </Grid>
</Window>