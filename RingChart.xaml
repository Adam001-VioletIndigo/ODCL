<UserControl
    x:Class="ODCL.RingChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Grid Width="160" Height="160">
        <Canvas x:Name="Draw" Width="160" Height="160" />
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Spacing="0">
            <TextBlock x:Name="ValueText" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock x:Name="LabelText" FontSize="11" Opacity="0.6" HorizontalAlignment="Center" />
        </StackPanel>
    </Grid>
</UserControl>