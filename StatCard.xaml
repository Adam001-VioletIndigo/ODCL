<UserControl
    x:Class="ODCL.StatCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ODCL">

    <Grid x:Name="Root">
        <!-- 横向：环在左，文字在右 -->
        <StackPanel x:Name="HorzBox" Orientation="Horizontal" Spacing="12" Visibility="Collapsed">
            <models:RingChart x:Name="HRing" ChartSize="48" VerticalAlignment="Center" />
            <StackPanel VerticalAlignment="Center" Spacing="1">
                <TextBlock x:Name="HValue" FontSize="15" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="HCaption" FontSize="11" Opacity="0.8" TextWrapping="Wrap" />
                <TextBlock x:Name="HExtra" FontSize="11" Foreground="#F5A623" TextWrapping="Wrap" />
                <StackPanel x:Name="HLegend" Spacing="1" />
            </StackPanel>
        </StackPanel>

        <!-- 纵向：环在上，图例两行紧随其下，文字在下 -->
        <StackPanel x:Name="VertBox" Orientation="Vertical" Spacing="4" HorizontalAlignment="Center" Visibility="Collapsed">
            <models:RingChart x:Name="VRing" ChartSize="72" HorizontalAlignment="Center" />
            <StackPanel x:Name="VLegend" Spacing="2" />
            <TextBlock x:Name="VValue" HorizontalAlignment="Center" TextAlignment="Center" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
            <TextBlock x:Name="VCaption" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12" Opacity="0.8" TextWrapping="Wrap" />
            <TextBlock x:Name="VExtra" HorizontalAlignment="Center" TextAlignment="Center" FontSize="12" Foreground="#F5A623" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>