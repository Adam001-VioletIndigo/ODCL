<Window
    x:Class="ODCL.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:models="using:ODCL">

    <Grid Padding="14" RowSpacing="8" ColumnSpacing="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 状态统计条 -->
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
            <TextBlock x:Name="StatsTxt" FontSize="12" TextWrapping="NoWrap" />
        </ScrollViewer>

        <!-- 工具栏 -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
            <Button x:Name="RefreshBtn" Content="刷新" Click="RefreshBtn_Click" />
            <Button x:Name="DeleteBtn" Content="删除选中" Click="DeleteBtn_Click" />
            <Button x:Name="VacuumBtn" Content="VACUUM 重建" Click="VacuumBtn_Click" />
            <Button x:Name="MoveBtn" Content="转移数据库" Click="MoveBtn_Click" />
            <Button x:Name="ChangeDbBtn" Content="打开其他库" Click="ChangeDbBtn_Click" />
            <ComboBox x:Name="SortBox" MinWidth="150" SelectionChanged="SortBox_SelectionChanged" />
            <TextBlock x:Name="DiskHint" VerticalAlignment="Center" Foreground="#FFA500" />
        </StackPanel>

        <!-- 主区域 -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="420" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <ListView x:Name="SessionList" SelectionMode="Multiple" SelectionChanged="SessionList_SelectionChanged">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:SessionItem">
                        <StackPanel Padding="2,4">
                            <TextBlock Text="{x:Bind Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{x:Bind Sub}" FontSize="11" Opacity="0.65" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Grid Grid.Column="1" RowSpacing="6">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="220" />
                </Grid.RowDefinitions>
                <TreeView x:Name="MsgTree" ItemInvoked="MsgTree_ItemInvoked" />
                <ScrollViewer Grid.Row="1">
                    <TextBlock x:Name="DetailText" IsTextSelectionEnabled="True" FontFamily="Consolas" FontSize="12" />
                </ScrollViewer>
            </Grid>
        </Grid>

        <!-- 进度条 -->
        <ProgressBar x:Name="Progress" Grid.Row="3" Height="4" Visibility="Collapsed" />
    </Grid>
</Window>